{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "occurred_at",
    "correlation_id",
    "idempotency_key",
    "data"
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "\\S"
    }
  },
  "properties": {
    "event_id": {
      "$ref": "#/$defs/identifier"
    },
    "event_type": {
      "const": "task.publish_requested.v1"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "$ref": "#/$defs/identifier"
    },
    "idempotency_key": {
      "$ref": "#/$defs/identifier"
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "receipt_id",
        "scheduled_at"
      ],
      "properties": {
        "task_id": {
          "$ref": "#/$defs/identifier"
        },
        "receipt_id": {
          "$ref": "#/$defs/identifier"
        },
        "scheduled_at": {
          "type": "string",
          "format": "date-time"
        },
        "account_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "media_version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
